{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/((?!assets/|_ds/|.*\\.).*)",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    }
  ],
  "rewrites": [
    { "source": "/story-starters/:slug", "destination": "/story-starter" },
    { "source": "/stickers/:code", "destination": "/stickers" }
  ]
}
